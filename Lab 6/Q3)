class WashingMachine
{
    void on()
    {
        System.out.println("Machine on");
    }

    int clothes(int x)
    {
        System.out.println("You put " + x + " kapde inside");
        return x;
    }

    void soap()
    {
        System.out.println("Soap go brrrr");
    }

    void off()
    {
        System.out.println("Machine tired. Bye.");
    }
}

public class washingMachine
{
    public static void main(String[] args)
    {
        WashingMachine washingmachine = new WashingMachine();

        washingmachine.on();
        int c = washingmachine.clothes(6);
        washingmachine.soap();
        washingmachine.off();
    }
}
