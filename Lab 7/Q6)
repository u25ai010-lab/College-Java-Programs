class Course {
    int id;
    String desc;
    int time;       // in months or whatever
    double money;

    Course(int i, String d, int t, double m) {
        id = i;
        desc = d;
        time = t;
        money = m;
    }

    void show() {
        System.out.println("ID is: " + id);
        System.out.println("Course name: " + desc);
        System.out.println("Duration" + time + " months");
        System.out.println("Fees " + money + " rupees");
        System.out.println("---------------");
    }
}

public class Q6 {

    public static void main(String[] args) {

        Course arr[] = new Course[5];

        arr[0] = new Course(101, "Java", 6, 15000);
        arr[1] = new Course(102, "Python", 5, 12000);
        arr[2] = new Course(103, "C", 4, 10000);
        arr[3] = new Course(104, "DSA", 6, 18000);
        arr[4] = new Course(105, "ML", 8, 25000);

        for (int i = 0; i < 5; i++) {
            arr[i].show();
        }
    }
}
